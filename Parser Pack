alter upn = lowercase(userPrincipalName),
      ip = ipAddress,
      app = appDisplayName,
      app_id = appId,
      resource = resourceDisplayName,
      client_app = clientAppUsed,
      sp_name = servicePrincipalName,
      error_code = to_string(status) -> errorCode,
      failure_reason = to_string(status) -> failureReason,
      status_detail = to_string(status) -> additionalDetails,
      country = to_string(location) -> countryOrRegion,
      state = to_string(location) -> state,
      city = to_string(location) -> city,
      os = to_string(deviceDetail) -> operatingSystem,
      browser = to_string(deviceDetail) -> browser,
      device_id = to_string(deviceDetail) -> deviceId,
      device_name = to_string(deviceDetail) -> displayName,
      compliant = to_string(deviceDetail) -> isCompliant,
      managed = to_string(deviceDetail) -> isManaged,
      trust_type = to_string(deviceDetail) -> trustType,
      interactive = to_string(isInteractive),
      sign_in_type = to_string(signInEventTypes),
      auth_requirement = authenticationRequirement,
      auth_protocol = authenticationProtocol,
      ca_status = conditionalAccessStatus,
      risk_events = to_string(riskEventTypes_v2),
      ca_policies = to_string(appliedConditionalAccessPolicies) -> [],
      auth_steps = to_string(authenticationDetails) -> []
| alter ca_failed = arraystring(arraymap(arrayfilter(ca_policies, "@element" -> result = "failure"), "@element" -> displayName), ", "),
        ca_success = arraystring(arraymap(arrayfilter(ca_policies, "@element" -> result = "success"), "@element" -> displayName), ", "),
        auth_methods = arraystring(arraymap(auth_steps, "@element" -> authenticationMethod), ", "),
        auth_step_results = arraystring(arraymap(auth_steps, "@element" -> authenticationStepResultDetail), ", ")